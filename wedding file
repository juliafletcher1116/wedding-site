<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Julia & Max | May 1, 2027</title>

<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">

<style>

/* =========================
   GLOBAL STYLES
========================= */

:root{
  --olive:#6E7B4F;
  --terra:#B56B45;
  --cream:#F6F0E6;
  --tan:#E9DDCD;
  --dark:#1F1F1F;
}

*{margin:0;padding:0;box-sizing:border-box;}

body{
  font-family:Inter,sans-serif;
  background:var(--cream);
  color:var(--dark);
  scroll-behavior:smooth;
}

section{
  padding:120px 10%;
}

h2{
  font-family:"Cormorant Garamond",serif;
  font-size:44px;
  margin-bottom:60px;
  text-align:center;
}

/* =========================
   NAVIGATION
========================= */

nav{
  position:fixed;
  top:0;
  width:100%;
  background:rgba(246,240,230,.95);
  backdrop-filter:blur(10px);
  display:flex;
  justify-content:center;
  gap:35px;
  padding:18px;
  z-index:1000;
  border-bottom:1px solid rgba(0,0,0,.05);
}

nav a{
  text-decoration:none;
  font-size:13px;
  letter-spacing:.12em;
  text-transform:uppercase;
  color:#444;
  transition:.3s;
}

nav a:hover{color:var(--olive);}

/* =========================
   HERO CAROUSEL
========================= */

.hero{
  height:100vh;
  position:relative;
  overflow:hidden;
}

.hero-slide{
  position:absolute;
  width:100%;
  height:100%;
  background-size:cover;
  background-position:center;
  opacity:0;
  transition:opacity 1.5s ease-in-out;
}

.hero-slide.active{opacity:1;}

.hero-overlay{
  position:absolute;
  width:100%;
  height:100%;
  background:linear-gradient(to bottom, rgba(0,0,0,.2), rgba(0,0,0,.55));
}

.hero-content{
  position:absolute;
  bottom:20%;
  width:100%;
  text-align:center;
  color:white;
}

.hero h1{
  font-family:"Cormorant Garamond",serif;
  font-size:72px;
  font-weight:600;
}

.hero p{
  margin-top:10px;
  font-size:18px;
  letter-spacing:.08em;
}

/* =========================
   SCHEDULE
========================= */

.schedule-card{
  max-width:800px;
  margin:40px auto;
  background:white;
  padding:50px;
  border-radius:25px;
  box-shadow:0 25px 60px rgba(0,0,0,.05);
  transition:.4s;
}

.schedule-card:hover{
  transform:translateY(-5px);
  box-shadow:0 35px 80px rgba(0,0,0,.08);
}

.schedule-card h3{
  font-family:"Cormorant Garamond",serif;
  font-size:30px;
  margin-bottom:10px;
  color:var(--olive);
}

.schedule-card p{
  margin-bottom:8px;
  line-height:1.6;
}

/* =========================
   HOTEL / RESTAURANT CARDS
========================= */

.hotel-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
  gap:30px;
}

.hotel-card{
  background:white;
  padding:40px;
  border-radius:25px;
  box-shadow:0 20px 50px rgba(0,0,0,.05);
  transition:.4s;
  position:relative;
  overflow:hidden;
}

.hotel-card::before{
  content:"";
  position:absolute;
  top:0;
  left:0;
  width:100%;
  height:5px;
  background:var(--olive);
  transition:.4s;
}

.hotel-card:hover{
  transform:translateY(-8px);
  box-shadow:0 30px 70px rgba(0,0,0,.12);
}

.hotel-card:hover::before{
  height:100%;
  opacity:.07;
}

.hotel-card h3{
  font-family:"Cormorant Garamond",serif;
  margin-bottom:12px;
}

.hotel-card a{
  display:inline-block;
  margin-top:15px;
  text-decoration:none;
  font-weight:500;
  color:var(--olive);
}

/* =========================
   CUSTOM CARMEL MAP
========================= */

.carmel-map{
  position:relative;
  max-width:1000px;
  margin:60px auto 0 auto;
  border-radius:30px;
  overflow:hidden;
  box-shadow:0 30px 60px rgba(0,0,0,.08);
}

.map-bg{
  width:100%;
  filter:brightness(.95);
}

.marker{
  position:absolute;
  width:22px;
  height:22px;
  background:var(--olive);
  border-radius:50%;
  transform:translate(-50%, -50%);
  cursor:pointer;
  transition:.3s;
  box-shadow:0 0 0 6px rgba(110,123,79,.25);
}

.marker:hover{
  transform:translate(-50%, -50%) scale(1.3);
  background:var(--terra);
}

.marker::after{
  content:attr(data-label);
  position:absolute;
  bottom:150%;
  left:50%;
  transform:translateX(-50%);
  background:white;
  padding:6px 12px;
  border-radius:20px;
  font-size:12px;
  white-space:nowrap;
  opacity:0;
  transition:.3s;
  box-shadow:0 10px 20px rgba(0,0,0,.1);
}

.marker:hover::after{opacity:1;}

/* =========================
   GALLERY
========================= */

.gallery{
  column-count:3;
  column-gap:20px;
}

.gallery img{
  width:100%;
  margin-bottom:20px;
  border-radius:18px;
  transition:.4s;
}

.gallery img:hover{
  transform:scale(1.03);
}

@media(max-width:900px){.gallery{column-count:2;}}
@media(max-width:600px){.gallery{column-count:1;}}

/* =========================
   WEDDING PARTY
========================= */

.party-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
  gap:30px;
  text-align:center;
}

.party-member{
  padding:20px;
  background:white;
  border-radius:20px;
  box-shadow:0 15px 40px rgba(0,0,0,.05);
  transition:.3s;
}

.party-member:hover{
  transform:translateY(-5px);
}

/* =========================
   FAQ
========================= */

.faq-item{
  max-width:800px;
  margin:20px auto;
  background:white;
  border-radius:20px;
  padding:30px;
  box-shadow:0 15px 40px rgba(0,0,0,.05);
  cursor:pointer;
}

.faq-answer{
  display:none;
  margin-top:12px;
  line-height:1.6;
}

/* =========================
   REGISTRY
========================= */

.registry{
  text-align:center;
}

.registry a{
  display:inline-block;
  margin-top:20px;
  padding:15px 35px;
  background:var(--olive);
  color:white;
  text-decoration:none;
  border-radius:40px;
  transition:.3s;
}

.registry a:hover{background:#55663a;}

</style>
</head>

